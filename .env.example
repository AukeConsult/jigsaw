# Secrets and settings for the scripts in this repo. This file is in .gitignore: never commit it, never paste it in a chat.
# This is the template (committed). Copy it to .env and fill it in.

# The Firebase project (shared with Seven Friends)
FIREBASE_PROJECT_ID=sevenfriends

# The apps (the Android package name = applicationId, the iPhone bundle id): `npm run android:config` and `ios:config` make the Firebase files for them
ANDROID_PACKAGE=io.karinsjigsaw.app
IOS_BUNDLE_ID=io.karinsjigsaw.app

# Android release signing (client-wrappers/android/app/build.gradle; without it the APK is signed with the debug key). Keep the keystore for good: an app can only be updated by one signed with the same key. Never commit.
SF_KEYSTORE=
SF_KEYSTORE_PASSWORD=
SF_KEY_ALIAS=
SF_KEY_PASSWORD=

# Windows code signing (scripts/windows-sign.mjs): a .pfx certificate that stays on this computer, so Windows shows the publisher instead of "Unknown". Never commit.
SF_SIGN_PFX=
SF_SIGN_PFX_PASSWORD=

# OpenAI: the AI classification of a jigsaw (its categories, name and description from its picture). `npm run sync:env` copies these to the functions.
# The key is a PROJECT key (sk-proj-...) of one project: it is all the classification needs. Never put an admin key here.
OPENAI_API_KEY=
# The model that looks at the picture (a model that can see pictures). Required: there is no default.
OPENAI_MODEL=
# How closely the picture is looked at: low (cheap and fast) or high. low when not said.
OPENAI_IMAGE_DETAIL=low
# Optional: the organization and the project the key belongs to (sent with each request when given)
OPENAI_ORG_ID=
OPENAI_PROJECT_ID=
